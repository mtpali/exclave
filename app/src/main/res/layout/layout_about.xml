<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:textDirection="rtl">

    <include layout="@layout/layout_appbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_about"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:layoutDirection="rtl"
        android:textDirection="rtl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layoutDirection="rtl"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="22dp"
            android:paddingEnd="18dp"
            android:paddingBottom="36dp"
            android:textDirection="rtl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mobiletina_about_title"
                android:textColor="@color/mobiletina_about_text"
                android:textDirection="rtl"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="22dp"
                android:gravity="center"
                android:text="@string/mobiletina_about_subtitle"
                android:textColor="@color/mobiletina_about_secondary"
                android:textDirection="rtl"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/about_instagram_one"
                style="@style/MobileTinaAboutCard">
                <LinearLayout style="@style/MobileTinaAboutRow">
                    <View style="@style/MobileTinaAboutInstagramStripe" />
                    <LinearLayout style="@style/MobileTinaAboutTextBox">
                        <TextView style="@style/MobileTinaAboutLabel" android:text="@string/mobiletina_about_branch_one" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/about_instagram_two"
                style="@style/MobileTinaAboutCard">
                <LinearLayout style="@style/MobileTinaAboutRow">
                    <View style="@style/MobileTinaAboutInstagramStripe" />
                    <LinearLayout style="@style/MobileTinaAboutTextBox">
                        <TextView style="@style/MobileTinaAboutLabel" android:text="@string/mobiletina_about_branch_two" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/about_instagram_three"
                style="@style/MobileTinaAboutCard">
                <LinearLayout style="@style/MobileTinaAboutRow">
                    <View style="@style/MobileTinaAboutInstagramStripe" />
                    <LinearLayout style="@style/MobileTinaAboutTextBox">
                        <TextView style="@style/MobileTinaAboutLabel" android:text="@string/mobiletina_about_page_three" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/about_developer"
                style="@style/MobileTinaAboutCard">
                <LinearLayout style="@style/MobileTinaAboutRow">
                    <View
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="@color/mobiletina_about_telegram" />
                    <LinearLayout style="@style/MobileTinaAboutTextBox">
                        <TextView style="@style/MobileTinaAboutLabel" android:text="@string/mobiletina_about_developer" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="13dp"
                android:text="@string/mobiletina_about_stores_title"
                android:textColor="@color/mobiletina_about_text"
                android:textDirection="rtl"
                android:textSize="21sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView style="@style/MobileTinaAboutAddressCard">
                <TextView
                    style="@style/MobileTinaAboutAddress"
                    android:text="@string/mobiletina_about_store_one_full" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/MobileTinaAboutAddressCardLast">
                <TextView
                    style="@style/MobileTinaAboutAddress"
                    android:text="@string/mobiletina_about_store_two_full" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
