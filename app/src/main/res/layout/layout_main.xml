<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout" android:layout_width="match_parent"
    android:layout_height="match_parent" tools:openDrawer="start">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:fitsSystemWindows="true" android:orientation="vertical">
        <LinearLayout android:id="@+id/mobiletina_home_header" android:layout_width="match_parent"
            android:layout_height="150dp" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="72dp"
                android:paddingStart="12dp" android:paddingEnd="12dp">
                <ImageButton android:id="@+id/mobiletina_menu" android:layout_width="56dp"
                    android:layout_height="56dp" android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mobiletina_open_menu" android:padding="12dp"
                    android:scaleType="center" android:src="@drawable/ic_navigation_menu" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical" android:layout_marginStart="68dp"
                    android:text="@string/mobiletina_app_title" android:textSize="25sp"
                    android:textStyle="bold" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:layout_gravity="end" android:gravity="center" android:orientation="horizontal">
                    <ImageButton android:id="@+id/mobiletina_scan" android:layout_width="52dp"
                        android:layout_height="52dp" android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mobiletina_scan" android:padding="13dp"
                        android:src="@drawable/ic_image_camera_alt" android:tint="?android:attr/textColorPrimary" />
                    <ImageButton android:id="@+id/mobiletina_add" android:layout_width="52dp"
                        android:layout_height="52dp" android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/mobiletina_add" android:padding="13dp"
                        android:src="@drawable/ic_action_note_add" />
                    <ImageButton android:id="@+id/mobiletina_more" android:layout_width="48dp"
                        android:layout_height="52dp" android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/more" android:padding="13dp"
                        android:src="@drawable/ic_baseline_more_vert_24" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                android:layout_marginStart="18dp" android:layout_marginTop="2dp"
                android:layout_marginEnd="18dp" android:background="@drawable/mobiletina_mode_surface"
                android:gravity="center" android:orientation="horizontal" android:padding="4dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_mode_manual"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="2dp"
                    android:layout_weight="1" android:gravity="center" android:insetLeft="0dp"
                    android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp"
                    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:text="@string/mobiletina_mode_manual" android:textAllCaps="false"
                    android:textSize="15sp" android:textStyle="bold" app:cornerRadius="21dp"
                    app:strokeWidth="0dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_mode_auto"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="2dp"
                    android:layout_weight="1" android:gravity="center" android:insetLeft="0dp"
                    android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp"
                    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:text="@string/mobiletina_mode_auto" android:textAllCaps="false"
                    android:textSize="15sp" android:textStyle="bold" app:cornerRadius="21dp"
                    app:strokeWidth="0dp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout android:id="@+id/mode_container" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1"
            android:clipChildren="false" android:clipToPadding="false">
            <androidx.coordinatorlayout.widget.CoordinatorLayout android:id="@+id/coordinator"
                android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="false">
                <androidx.coordinatorlayout.widget.CoordinatorLayout android:id="@+id/fragment_holder"
                    android:layout_width="match_parent" android:layout_height="match_parent" />
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/fabProgress" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:max="1" android:visibility="invisible"
                    app:indicatorColor="?colorMaterial100" app:layout_anchor="@+id/fab"
                    app:layout_anchorGravity="center" app:layout_behavior="io.nekohasekai.sagernet.widget.FabProgressBehavior"
                    app:trackCornerRadius="@dimen/mtrl_progress_track_thickness" app:trackThickness="8dp" />
                <io.nekohasekai.sagernet.widget.ServiceButton android:id="@+id/fab"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:elevation="6dp" android:nextFocusDown="@+id/stats"
                    app:backgroundTint="?fabColorBackground" app:layout_anchor="@id/stats"
                    app:pressedTranslationZ="6dp" app:srcCompat="@drawable/ic_service_idle" />
                <io.nekohasekai.sagernet.widget.StatsBar android:id="@+id/stats"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="bottom" android:nextFocusUp="@+id/fab"
                    app:backgroundTint="?colorPrimary" app:contentInsetStart="0dp"
                    app:fabAlignmentMode="center" app:fabCradleMargin="5dp"
                    app:fabCradleRoundedCornerRadius="6dp" app:fabCradleVerticalOffset="0dp"
                    app:hideOnScroll="true" app:layout_scrollFlags="enterAlways|scroll">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/tx" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_gravity="start"
                            android:ellipsize="marquee" android:textColor="?whiteOrTextPrimary" android:textSize="14sp" />
                        <TextView android:id="@+id/rx" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_gravity="start"
                            android:ellipsize="marquee" android:textColor="?whiteOrTextPrimary" android:textSize="14sp" />
                        <TextView android:id="@+id/status" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_gravity="start"
                            android:ellipsize="marquee" android:textColor="?whiteOrTextPrimary"
                            android:textSize="16sp" tools:text="@string/connection_test_available" />
                    </LinearLayout>
                </io.nekohasekai.sagernet.widget.StatsBar>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>

            <ScrollView android:id="@+id/auto_panel" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center_horizontal"
                android:fillViewport="true" android:overScrollMode="never">
              <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="vertical"
                android:paddingStart="18dp" android:paddingTop="24dp"
                android:paddingEnd="18dp" android:paddingBottom="24dp">
                <com.google.android.material.imageview.ShapeableImageView android:id="@+id/fab_auto"
                    android:layout_width="236dp" android:layout_height="236dp"
                    android:background="@android:color/transparent" android:clickable="true"
                    android:contentDescription="@string/mobiletina_connect_action" android:focusable="true"
                    android:scaleType="fitCenter" android:src="@drawable/mt_auto_white"
                    app:shapeAppearanceOverlay="@style/MobileTinaCircleFab" />
                <TextView android:id="@+id/tv_auto_status" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center"
                    android:text="@string/mobiletina_status_disconnected"
                    android:textAppearance="@style/TextAppearance.AppCompat.Title" android:textStyle="bold" />
                <TextView android:id="@+id/tv_auto_server" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:ellipsize="end"
                    android:gravity="center" android:maxLines="2" android:textColor="@color/mobiletina_status_secondary"
                    android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_auto_ping" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:gravity="center" android:paddingHorizontal="18dp" android:paddingVertical="5dp"
                    android:textColor="@color/mobiletina_status_secondary" android:textStyle="bold"
                    android:visibility="gone" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/subscription_card" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginStart="18dp"
                    android:layout_marginTop="28dp" android:layout_marginEnd="18dp"
                    app:cardBackgroundColor="@color/mobiletina_mode_unselected"
                    app:cardCornerRadius="18dp" app:cardElevation="0dp"
                    app:strokeColor="@color/mobiletina_mode_stroke" app:strokeWidth="1dp"
                    android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="18dp">
                        <TextView android:id="@+id/tv_subscription_name" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:gravity="center"
                            android:textSize="16sp" android:textStyle="bold" />
                        <ProgressBar android:id="@+id/subscription_progress" style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent" android:layout_height="6dp"
                            android:layout_marginTop="18dp" android:max="100" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:orientation="horizontal">
                            <TextView android:id="@+id/tv_subscription_days" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:gravity="center" android:textStyle="bold" />
                            <TextView android:id="@+id/tv_subscription_traffic" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:gravity="center" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
              </LinearLayout>
            </ScrollView>

            <FrameLayout android:id="@+id/manual_dock" android:layout_width="match_parent"
                android:layout_height="142dp" android:layout_gravity="bottom"
                android:background="@color/mobiletina_manual_dock_bg"
                android:clipChildren="false" android:clipToPadding="false" android:visibility="gone">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/fab_manual" android:layout_width="88dp" android:layout_height="88dp"
                    android:layout_gravity="top|center_horizontal" android:translationY="-27dp"
                    android:background="@android:color/transparent" android:clickable="true"
                    android:focusable="true" android:scaleType="fitCenter"
                    android:src="@drawable/mt_manual_stop" />
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btn_smart_connect" android:layout_width="142dp" android:layout_height="46dp"
                    android:layout_gravity="top|center_horizontal" android:layout_marginTop="62dp"
                    android:background="@android:color/transparent" android:clickable="true"
                    android:focusable="true" android:scaleType="fitCenter"
                    android:src="@drawable/mt_manual_auto" />
                <TextView android:id="@+id/tv_manual_selected" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_gravity="bottom"
                    android:layout_marginHorizontal="24dp" android:layout_marginBottom="8dp"
                    android:ellipsize="end" android:gravity="center" android:maxLines="1"
                    android:textColor="@color/mobiletina_manual_dock_text" android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView android:id="@+id/nav_view"
        style="@style/Widget.Design.NavigationView" android:layout_width="wrap_content"
        android:layout_height="match_parent" android:layout_gravity="start"
        android:layoutDirection="ltr" android:textDirection="ltr" android:textAlignment="viewStart"
        app:itemIconTint="@color/navigation_icon" app:itemTextColor="@color/navigation_icon"
        app:headerLayout="@layout/mobiletina_nav_header" app:itemMaxLines="10"
        app:menu="@menu/main_drawer_menu" />
    <com.google.android.material.navigation.NavigationView android:id="@+id/nav_view_black"
        style="@style/Widget.Design.NavigationView" android:layout_width="wrap_content"
        android:layout_height="match_parent" android:layout_gravity="start"
        android:layoutDirection="ltr" android:textDirection="ltr" android:textAlignment="viewStart"
        app:itemIconTint="@color/navigation_icon" app:itemShapeAppearance="@style/ShapeAppearance.MaterialComponents.MediumComponent"
        app:itemShapeFillColor="@color/navigation_item" app:itemTextColor="@color/navigation_icon"
        app:headerLayout="@layout/mobiletina_nav_header" app:itemMaxLines="10"
        app:menu="@menu/main_drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
